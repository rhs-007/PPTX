{
  "name": "default",
  "description": "Old DL lesson decks (Phonics / Reading / Writing, English and Spanish) -> new DL templates. Rules learned from the Phonics sample and the old decks of all three strands.",
  "families": {
    "opening_layout": "Opening Slide|^Title Slide$",
    "outcomes1_layout": "(Learning|Lesson) Outcomes? 1",
    "outcomes2_layout": "(Learning|Lesson) Outcomes? 2",
    "outcomes_text": "^\\s*(in this lesson|en esta lecci[oó]n)\\s*:?\\s*$",
    "outcomes2_text": "(did you meet|lograste)",
    "opening_new": [
      "Opening Slide",
      "@first"
    ],
    "outcomes1_new": [
      "Lesson Outcomes 1"
    ],
    "outcomes2_new": [
      "Lesson Outcomes 2"
    ]
  },
  "map_drop_non_text": true,
  "title_style": {
    "split_at": "|",
    "after_split_rpr": {
      "b": "0"
    }
  },
  "time_pattern": "\\s*(\\(\\s*\\d+(?:\\s*[-–]\\s*\\d+)?\\s*min\\.?\\s*\\))\\s*$",
  "base_fonts": [
    "Century Gothic",
    "MS PGothic",
    "Arial",
    "Verdana",
    "Calibri"
  ],
  "drop_slide_background": false,
  "designer_notes": "under_collaborate",
  "designer_note_regex": "(?i)(art\\s*-?\\s*spec|artspec|for\\s+print|print\\s+trs|\\bdsn\\b|\\btrs\\s*#|please\\s+(add|insert|update|place|use|crop|replace|delete|remove|make)\\b|\\binsert\\b.{0,40}\\b(video|image|photo|slide|cover|page|card)s?\\b|^\\s*x\\d{4,}\\s*$|\\bvideo of\\b|\\bredux\\b|\\bboilerplate\\b|^\\s*(edit|editor'?s?\\s+note|note\\s+to\\s+(dsn|design))\\s*:)",
  "labels": {
    "en": {
      "outcomes": "Learning Outcomes",
      "teach": "Teach",
      "student": "Collaborate"
    },
    "es": {
      "outcomes": "Objetivos de aprendizaje",
      "teach": "Enseñar",
      "student": "Colaborar"
    }
  },
